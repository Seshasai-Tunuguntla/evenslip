{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "unicorn", "import", "react", "jsx-a11y", "nextjs", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["error", "warn", "info"] }],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/consistent-type-imports": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "server-only"] }],
    "vitest/valid-expect": ["error", { "maxArgs": 2 }]
  },
  "env": {
    "es2024": true,
    "node": true,
    "browser": true
  },
  "overrides": [
    {
      "files": ["src/app/**", "src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@/server/db",
                "message": "Pages and components read data through src/server/queries.ts, which checks membership first."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["**/.next/**", "**/node_modules/**", "**/coverage/**", "next-env.d.ts"]
}
