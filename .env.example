# Copy to .env.local for `npm run dev`. Never commit real values.
DATABASE_URL=postgresql://localhost:5432/evenslip_dev
# 32 random bytes, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Optional: a GitHub OAuth app (callback http://localhost:3000/api/auth/callback/github).
# Without these the GitHub button is hidden and only the demo works.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
